{
  "name": "logs",
  "main": "./sdk/dist/index.cjs",
  "module": "./sdk/dist/index.js",
  "types": "./sdk/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./sdk/dist/index.d.ts",
      "bun": "./sdk/src/index.ts",
      "import": "./sdk/dist/index.js",
      "require": "./sdk/dist/index.cjs",
      "default": "./sdk/dist/index.js"
    },
    "./transport": {
      "types": "./sdk/dist/pino-transport.d.ts",
      "bun": "./sdk/src/pino-transport.ts",
      "import": "./sdk/dist/pino-transport.js",
      "require": "./sdk/dist/pino-transport.cjs",
      "default": "./sdk/dist/pino-transport.js"
    }
  },
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run main.ts",
    "check": "bun run check.ts",
    "build": "bun run --cwd sdk build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@openobserve/browser-logs": "^0.4.3",
    "@openobserve/browser-rum": "^0.4.3",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  }
}
