# Endpoint de ingesta JSON de OpenObserve.
OPENOBSERVE_URL=https://api.openobserve.ai/api/default/nodejs/_json

# Credenciales (obligatorias).
OPENOBSERVE_USERNAME=tu-usuario
OPENOBSERVE_PASSWORD=tu-contraseña

# Alternativa a usuario/contraseña: clave ya codificada en Base64.
# OPENOBSERVE_AUTH_KEY=dG91c2VyOmNsYXZl

# Se pueden construir la URL por partes en lugar de usar OPENOBSERVE_URL.
# OPENOBSERVE_BASE_URL=https://observe.flexzin.space
# OPENOBSERVE_ORG=default
# OPENOBSERVE_STREAM=nodejs

# Nivel mínimo de los logs.
LOG_LEVEL=info

# El nombre del proyecto es el stream de OPENOBSERVE_URL, no hay que declararlo.
# Los logs de nivel error van además al stream "default" de la misma organización.
